def send_motor(
    left,
    right,
    reverse=False,
    force=False
):
    global last_left
    global last_right
    global last_reverse

    left = max(
        0,
        min(255, int(left))
    )

    right = max(
        0,
        min(255, int(right))
    )

    if (
        not force
        and left == last_left
        and right == last_right
        and reverse == last_reverse
    ):
        return

    try:

        if reverse:

            left_command = {
                "N": 1,
                "H": "G29L",
                "D1": 1,
                "D2": left,
                "D3": 2
            }

            right_command = {
                "N": 1,
                "H": "G29R",
                "D1": 2,
                "D2": right,
                "D3": 2
            }

            sock.sendall(
                json.dumps(
                    left_command
                ).encode()
            )

            sock.sendall(
                json.dumps(
                    right_command
                ).encode()
            )

        else:

            command = {
                "N": 4,
                "H": "G29",
                "D1": left,
                "D2": right
            }

            sock.sendall(
                json.dumps(command).encode()
            )

        last_left = left
        last_right = right
        last_reverse = reverse

    except Exception as e:
        print(
            "\nConnection error:",
            e
        )


