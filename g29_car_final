def request_ultrasonic():

    global sensor_id

    sensor_id += 1

    if sensor_id > 9999:
        sensor_id = 0

    command = {
        "N": 21,
        "H": f"US{sensor_id}",
        "D1": 2
    }

    try:

        sock.sendall(
            json.dumps(command).encode()
        )

    except Exception as e:

        print(
            "Ultrasonic request error:",
            e
        )


def read_sensor():

    global ultrasonic_cm

    try:

        ready, _, _ = select.select(
            [sock],
            [],
            [],
            0
        )

        if not ready:
            return

        data = sock.recv(4096)

        if not data:
            return

        text = data.decode(
            errors="ignore"
        )

        matches = re.findall(
            r"US\d+_(-?\d+(?:\.\d+)?)",
            text
        )

        if matches:

            ultrasonic_cm = float(
                matches[-1]
            )

    except Exception:
        pass


