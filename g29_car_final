def safety_check():

    global emergency_lock
    global gear
    global speed

    if (
        gear == DRIVE
        and ultrasonic_cm is not None
        and ultrasonic_cm <= EMERGENCY_DISTANCE
        and not emergency_lock
    ):

        emergency_lock = True

        gear = NEUTRAL
        speed = 0.0

        stop()

        print(
            "!!! EMERGENCY STOP !!!"
        )

    elif (
        emergency_lock
        and ultrasonic_cm is not None
        and ultrasonic_cm >= RESET_DISTANCE
    ):

        emergency_lock = False

        print(
            "Emergency lock cleared."
        )


# ============================================================
# VEHICLE PHYSICS
# ============================================================

def update_physics(
    gas,
    brake,
    dt
):

    global speed

    # --------------------------------------------------------
    # BRAKING
    #
    # Drive and Reverse intentionally use the SAME braking
    # equation.
    # --------------------------------------------------------

    if brake > 0.01:

        brake_strength = (
            brake ** 1.15
        )

        deceleration = (
            BRAKE_DECEL
            * brake_strength
        )

        speed -= (
            deceleration * dt
        )

        if speed <= BRAKE_STOP_THRESHOLD:

            speed = 0.0

        return

    # --------------------------------------------------------
    # PARK / NEUTRAL
    # --------------------------------------------------------

    if gear in (
        PARK,
        NEUTRAL
    ):

        speed -= (
            FRICTION * dt
        )

        if speed < 0:
            speed = 0.0

        return

    # --------------------------------------------------------
    # DRIVE
    # --------------------------------------------------------

    if gear == DRIVE:

        max_speed = (
            SPORT_MAX
            if mode == SPORT
            else ECO_MAX
        )

        target_speed = (
            gas * max_speed
        )

        if speed < target_speed:

            acceleration = (
                SPORT_ACCEL
                if mode == SPORT
                else ECO_ACCEL
            )

            speed += (
                acceleration * dt
            )

        elif speed > target_speed:

            speed -= (
                FRICTION * dt
            )

    # --------------------------------------------------------
    # REVERSE
    #
    # Same physics as Drive.
    # Only maximum speed is different.
    # --------------------------------------------------------

    elif gear == REVERSE:

        target_speed = (
            gas * REVERSE_MAX
        )

        if speed < target_speed:

            acceleration = (
                SPORT_ACCEL
                if mode == SPORT
                else ECO_ACCEL
            )

            speed += (
                acceleration * dt
            )

        elif speed > target_speed:

            speed -= (
                FRICTION * dt
            )

    # --------------------------------------------------------
    # FINAL CLAMP
    # --------------------------------------------------------

    if speed < 0:
        speed = 0.0


# ============================================================
# MOTOR CALCULATION
# ============================================================

def calculate_motors(
    steering,
    brake
):

    # If simulated speed is zero,
    # absolutely no drive command is sent.
    if speed <= 0.0:

        return 0, 0

    steering_effect = (
        steering * STEERING_GAIN
    )

    left = speed * (
        1.0 - steering_effect
    )

    right = speed * (
        1.0 + steering_effect
    )

    # --------------------------------------------------------
    # BRAKING
    # --------------------------------------------------------

    if brake > 0.01:

        if brake >= BRAKE_MOTOR_CUTOFF:

            left = 0.0
            right = 0.0

        else:

            brake_factor = max(
                0.0,
                1.0 - brake
            )

            left *= brake_factor
            right *= brake_factor

    left = max(
        0,
        min(255, left)
    )

    right = max(
        0,
        min(255, right)
    )

    return left, right


