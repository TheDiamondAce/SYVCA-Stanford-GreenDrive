def get_throttle():

    raw = wheel.get_axis(2)

    throttle = (
        1.0 - raw
    ) / 2.0

    return max(
        0.0,
        min(1.0, throttle)
    )


def get_brake():

    raw = wheel.get_axis(3)

    brake = (
        1.0 - raw
    ) / 2.0

    return max(
        0.0,
        min(1.0, brake)
    )


