def set_signal(new_signal):

    global turn_signal
    global signal_blink_state
    global last_signal_blink
    global signal_turn_started

    turn_signal = new_signal

    if new_signal == SIGNAL_OFF:
        signal_turn_started = False

    signal_blink_state = True
    last_signal_blink = time.monotonic()

    print(
        "TURN SIGNAL:",
        turn_signal
    )


def play_blinker_sound():

    if not BLINKER_SOUND_ENABLED:
        return

    try:

        if turn_signal == SIGNAL_LEFT:

            if left_blinker_sound:
                left_blinker_sound.play()

        elif turn_signal == SIGNAL_RIGHT:

            if right_blinker_sound:
                right_blinker_sound.play()

    except pygame.error:
        pass


def update_signal():

    global signal_blink_state
    global last_signal_blink

    if turn_signal == SIGNAL_OFF:

        signal_blink_state = False
        return

    now = time.monotonic()

    if (
        now - last_signal_blink
        >= BLINK_INTERVAL
    ):

        last_signal_blink = now

        signal_blink_state = (
            not signal_blink_state
        )

        # Sound only when the signal turns ON.
        if signal_blink_state:
            play_blinker_sound()


def auto_cancel_signal(steering):

    global turn_signal
    global signal_turn_started

    if turn_signal == SIGNAL_OFF:

        signal_turn_started = False
        return

    # Wheel is being turned.
    if abs(steering) > AUTO_SIGNAL_CANCEL_THRESHOLD:

        signal_turn_started = True
        return

    # Wheel has returned to center after a turn.
    if signal_turn_started:

        set_signal(
            SIGNAL_OFF
        )

        signal_turn_started = False


