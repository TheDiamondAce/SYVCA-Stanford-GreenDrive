def send_servo(command):

    global last_servo_command_time

    now = time.monotonic()

    if (
        now - last_servo_command_time
        < SERVO_REPEAT_INTERVAL
    ):
        return False

    packet = {
        "N": 106,
        "H": "LOOK",
        "D1": command
    }

    try:

        sock.sendall(
            json.dumps(packet).encode()
        )

        last_servo_command_time = now

        return True

    except Exception as e:

        print(
            "Servo error:",
            e
        )

        return False


def read_dpad():

    global look_direction
    global servo_steps_left
    global servo_steps_right

    if wheel.get_numhats() == 0:
        return

    hat_x, hat_y = wheel.get_hat(0)

    # --------------------------------------------------------
    # LEFT
    # --------------------------------------------------------

    if hat_x < 0:

        look_direction = LOOK_LEFT

        if (
            servo_steps_left
            < SERVO_RANGE_STEPS
        ):

            if send_servo(
                SERVO_LOOK_LEFT
            ):

                servo_steps_left += 1

        servo_steps_right = 0

    # --------------------------------------------------------
    # RIGHT
    # --------------------------------------------------------

    elif hat_x > 0:

        look_direction = LOOK_RIGHT

        if (
            servo_steps_right
            < SERVO_RANGE_STEPS
        ):

            if send_servo(
                SERVO_LOOK_RIGHT
            ):

                servo_steps_right += 1

        servo_steps_left = 0

    # --------------------------------------------------------
    # CENTER
    # --------------------------------------------------------

    else:

        if look_direction != LOOK_CENTER:

            send_servo(
                SERVO_LOOK_CENTER
            )

        look_direction = LOOK_CENTER

        servo_steps_left = 0
        servo_steps_right = 0


