def simulated_speed():

    # Existing simulated speed is effectively the
    # PWM-style vehicle speed value.
    #
    # Keep the HUD representation stable.

    kmh = (
        speed / 255.0
    ) * 100.0

    mph = (
        kmh * 0.621371
    )

    return kmh, mph


