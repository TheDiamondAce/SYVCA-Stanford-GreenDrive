def change_gear(new_gear):

    global gear

    # No change needed.
    if new_gear == gear:
        return

    # Do not switch directly between Drive and Reverse
    # while the simulated vehicle is moving.
    if (
        gear in (DRIVE, REVERSE)
        and new_gear in (DRIVE, REVERSE)
        and gear != new_gear
        and speed > GEAR_SHIFT_SPEED_THRESHOLD
    ):
        print(
            "SHIFT BLOCKED: vehicle must nearly stop first."
        )
        return

    # Do not enter Park while moving.
    if (
        new_gear == PARK
        and speed > GEAR_SHIFT_SPEED_THRESHOLD
    ):
        print(
            "PARK BLOCKED: vehicle must nearly stop first."
        )
        return

    gear = new_gear

    print(
        "GEAR:",
        gear
    )


# ============================================================
# GEAR BUTTON HANDLING
# ============================================================

previous_buttons = [
    False
] * wheel.get_numbuttons()


def process_gear_buttons():

    global previous_buttons

    current_buttons = [
        wheel.get_button(i)
        for i in range(
            wheel.get_numbuttons()
        )
    ]

    def pressed(button):

        if button >= len(
            current_buttons
        ):
            return False

        return (
            current_buttons[button]
            and not previous_buttons[button]
        )

    if pressed(BUTTON_TRIANGLE):

        if not emergency_lock:
            change_gear(DRIVE)

    elif pressed(BUTTON_SQUARE):

        change_gear(REVERSE)

    elif pressed(BUTTON_CIRCLE):

        change_gear(NEUTRAL)

    elif pressed(BUTTON_X):

        change_gear(PARK)

    previous_buttons = current_buttons


