# ============================================================
# MAIN LOOP
# ============================================================

last_time = time.monotonic()

try:

    while True:

        # ----------------------------------------------------
        # EVENTS
        # ----------------------------------------------------

        for event in pygame.event.get():

            if event.type == pygame.QUIT:

                raise KeyboardInterrupt

            if event.type == pygame.KEYDOWN:

                if event.key == pygame.K_ESCAPE:

                    gear = PARK
                    speed = 0.0

                    stop()

                    raise KeyboardInterrupt

                elif event.key == pygame.K_e:

                    mode = ECO

                    print(
                        "MODE: ECO"
                    )

                elif event.key == pygame.K_s:

                    mode = SPORT

                    print(
                        "MODE: SPORT"
                    )

        pygame.event.pump()

        # ----------------------------------------------------
        # TIMING
        # ----------------------------------------------------

        now = time.monotonic()

        dt = (
            now - last_time
        )

        last_time = now

        dt = min(
            dt,
            0.1
        )

        # ----------------------------------------------------
        # GEAR
        # ----------------------------------------------------

        process_gear_buttons()

        # ----------------------------------------------------
        # STEERING
        # ----------------------------------------------------

        steering = -wheel.get_axis(0)

        steering = max(
            -1.0,
            min(1.0, steering)
        )

        # ----------------------------------------------------
        # SIGNAL
        # ----------------------------------------------------

        # Paddle input.
        if wheel.get_button(
            PADDLE_LEFT_SIGNAL
        ):

            # Only trigger on paddle press
            # through the existing button edge logic below.
            pass

        # Detect paddle edges.
        if not hasattr(
            process_gear_buttons,
            "previous_paddles"
        ):

            process_gear_buttons.previous_paddles = {
                "left": False,
                "right": False
            }

        left_paddle = bool(
            wheel.get_button(
                PADDLE_LEFT_SIGNAL
            )
        )

        right_paddle = bool(
            wheel.get_button(
                PADDLE_RIGHT_SIGNAL
            )
        )

        previous_paddles = (
            process_gear_buttons.previous_paddles
        )

        if (
            left_paddle
            and not previous_paddles["left"]
        ):

            if turn_signal == SIGNAL_LEFT:

                set_signal(
                    SIGNAL_OFF
                )

            else:

                set_signal(
                    SIGNAL_LEFT
                )

        elif (
            right_paddle
            and not previous_paddles["right"]
        ):

            if turn_signal == SIGNAL_RIGHT:

                set_signal(
                    SIGNAL_OFF
                )

            else:

                set_signal(
                    SIGNAL_RIGHT
                )

        previous_paddles["left"] = left_paddle
        previous_paddles["right"] = right_paddle

        # Auto-cancel only after the vehicle has actually
        # started turning.
        auto_cancel_signal(
            steering
        )

        update_signal()

        # ----------------------------------------------------
        # D-PAD / CAMERA
        # ----------------------------------------------------

        read_dpad()

        # ----------------------------------------------------
        # THROTTLE
        # ----------------------------------------------------

        throttle = get_throttle()

        # ----------------------------------------------------
        # BRAKE
        # ----------------------------------------------------

        brake = get_brake()

        # ----------------------------------------------------
        # SAFETY SENSOR
        # ----------------------------------------------------

        now = time.monotonic()

        if (
            now - last_sensor_time
            >= SENSOR_INTERVAL
        ):

            last_sensor_time = now

            request_ultrasonic()

        read_sensor()

        safety_check()

        # ----------------------------------------------------
        # VEHICLE PHYSICS
        # ----------------------------------------------------

        update_physics(
            throttle,
            brake,
            dt
        )

        # ----------------------------------------------------
        # MOTOR OUTPUT
        # ----------------------------------------------------

        if gear in (
            PARK,
            NEUTRAL
        ):

            left_speed = 0
            right_speed = 0

            send_motor(
                0,
                0,
                reverse=False
            )

        else:

            left_speed, right_speed = (
                calculate_motors(
                    steering,
                    brake
                )
            )

            # ------------------------------------------------
            # IMPORTANT:
            #
            # If simulated speed is zero, send an actual
            # zero command regardless of gear.
            # ------------------------------------------------

            if speed <= 0.0:

                left_speed = 0
                right_speed = 0

            # ------------------------------------------------
            # REVERSE
            # ------------------------------------------------

            if gear == REVERSE:

                send_motor(
                    left_speed,
                    right_speed,
                    reverse=True
                )

            # ------------------------------------------------
            # DRIVE
            # ------------------------------------------------

            else:

                send_motor(
                    left_speed,
                    right_speed,
                    reverse=False
                )

        # ----------------------------------------------------
        # HUD
        # ----------------------------------------------------

        draw_hud(
            steering,
            throttle,
            brake,
            left_speed,
            right_speed
        )

        # ----------------------------------------------------
        # LOOP
        # ----------------------------------------------------

        clock.tick(
            LOOP_HZ
        )


# ============================================================
# CLEANUP
# ============================================================

except KeyboardInterrupt:

    print(
        "\n\nStopping..."
    )

finally:

    speed = 0.0

    stop()

    time.sleep(0.1)

    try:
        sock.close()
    except Exception:
        pass

    pygame.quit()

    print(
        "Car stopped."
    )